# Capture the averaged volume
variable vol_avg_tmp equal f_f_avg_vol
variable vol_avg equal ${vol_avg_tmp}
variable vol_avg equal 2159.64109072321

# Stage 16
unfix f_npt
unfix f_avg_vol
undump d_eq

# Stage 17
print "NPT EQUILIBRATION: avg volume (2nd half) = ${vol_avg}"
NPT EQUILIBRATION: avg volume (2nd half) = 2159.64109072321

# ============================================================ Rescale box to match NPT average volume ============================================================
variable vol_now equal vol
variable scale equal (${vol_avg}/${vol_now})^(1.0/3.0)
variable scale equal (2159.64109072321/${vol_now})^(1.0/3.0)
variable scale equal (2159.64109072321/2103.19769842588)^(1.0/3.0)
print "RESCALE: vol_now = ${vol_now}, vol_avg = ${vol_avg}, scale = ${scale}"
RESCALE: vol_now = 2103.19769842588, vol_avg = 2159.64109072321, scale = 1.00886679454612
change_box all x scale ${scale} y scale ${scale} z scale ${scale} remap units box
change_box all x scale 1.00886679454612 y scale ${scale} z scale ${scale} remap units box
change_box all x scale 1.00886679454612 y scale 1.00886679454612 z scale ${scale} remap units box
change_box all x scale 1.00886679454612 y scale 1.00886679454612 z scale 1.00886679454612 remap units box

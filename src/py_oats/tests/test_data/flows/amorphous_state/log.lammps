DENSITY CHECK: rho_end (after NPT) = 1.42693513711266 (for info only)
print "DENSITY CHECK: frac change (avg vs pre) = ${rho_frac_change}"
DENSITY CHECK: frac change (avg vs pre) = 0.236250758064569

# ============================================================ Branch based on 30% threshold ============================================================
variable use_initial equal ( ${rho_frac_change} > 0.3 )
variable use_initial equal ( 0.236250758064569 > 0.3 )

# Stage 30
if "${use_initial} == 1" then "jump SELF density_restore_initial"
jump SELF density_use_avg
print "DENSITY CHECK: change <= threshold -> rescaling NPT final structure to rho_avg for production NVT."
DENSITY CHECK: change <= threshold -> rescaling NPT final structure to rho_avg for production NVT.

# Stage 37 rescale box so density becomes rho_avg
variable rho_now equal density
variable s equal ( ${rho_now}/${rho_avg} )^(1.0/3.0)
variable s equal ( 1.42693513711266/${rho_avg} )^(1.0/3.0)
variable s equal ( 1.42693513711266/1.29624476357482 )^(1.0/3.0)

# Stage 38
print "DENSITY CHECK: rescale factor s = ${s}"

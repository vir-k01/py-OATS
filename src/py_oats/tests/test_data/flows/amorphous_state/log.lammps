variable rho_avg equal 1.29624476357482 
variable rho_end equal density # for printing only

# Stage 26
unfix f_npt
unfix avg_rho

# Correct comparison: avg during NPT vs pre-NPT density
variable rho_frac_change equal abs(${rho_avg}-${rho_init0})/${rho_init0}
variable rho_frac_change equal abs(1.29624476357482-${rho_init0})/${rho_init0}
variable rho_frac_change equal abs(1.29624476357482-1.04852899391073)/${rho_init0}
variable rho_frac_change equal abs(1.29624476357482-1.04852899391073)/1.04852899391073

# Stage 28
